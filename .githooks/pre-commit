#!/usr/bin/env bash
# Pre-commit mínimo (decisión del dueño): SOLO ruff check + ruff format --check,
# delegando en las recetas del Justfile (mismo pin `uvx ruff@0.17.1` que CI).
# Sin mypy ni pytest — esos corren en `just quality` / `just ci`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
just python-lint
just python-fmt-check
