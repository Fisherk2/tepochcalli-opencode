.codice-backup*
.codice-backup-intent

# System - Excludes OS temporary files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.tmp
*.temp

# Logs - Excludes log and error files
*.log
logs/
error.log
connection.log
postgresql.log
pg_log/

# Temporary - Excludes application cache and temp files
cache/
tmp/
temp/
*.cache
*.bak
*.backup
*.old

