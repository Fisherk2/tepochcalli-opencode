coverage.xml
*.cover
.hypothesis/
junit.xml
.tox/

# Configuration - Secrets and local files
#.env*
config/*secret*.yaml
config/*local*.yaml
*.secret.yaml
*.local.yaml

# npm token (contains Granular Access Token for publishing)
.npmrc

# Node.js modules
node_modules/

# Docker and Containers - Excludes container and orchestration configurations
.docker/
docker-compose.override.yml
*.kubeconfig
kubeconfig*

