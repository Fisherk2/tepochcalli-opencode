*.dump
*.sqlc
*.psql_history
pgadmin/
.postgresql/
pg_hba.conf.local
postgresql.conf.local

# Generated documentation - Excludes auto-generated files
docs/build/
#*.html
*.png.temp
diagrams/generated/
mermaid-output/

# Python - Virtual environment and dependencies
__pycache__/
*.py[cod]
*$py.class
venv/
env/
ENV/
.env/
.venv/

# Python - Build and distribution
dist/
build/
*.egg-info/
*.egg
*.whl

