# Plantilla de configuración del flow Tepochcalli (spec-embeddings.md §"Estructura
# de `tepochcalli.toml` (config/)", D11).
#
# El archivo REAL vive en `.tepochcalli/config/tepochcalli.toml`, está en .gitignore
# y NUNCA se commitea (puede contener la variable de una API key). Para usar esta
# plantilla: mkdir -p config && cp tepochcalli.toml.example config/tepochcalli.toml
# (relativo a este directorio `.tepochcalli/`).
#
# Claves ausentes = default; TOML malformado o claves desconocidas = warning + default
# (el loader nunca lanza; ver flow/tepochcalli_flow/config.py).

[embedding]
provider = "local"            # local | litellm
model = "paraphrase-multilingual-MiniLM-L12-v2"
device = "cpu"                # Solo provider="local": SentenceTransformer(..., device=). Opciones: "cpu" | "cuda" | "cuda:N" (p. ej. "cuda:0") | "mps" | "auto" (delega la detección). Valores de PyTorch/sentence-transformers: el loader no los valida; sin soporte falla al cargar el modelo, no al configurar.
# provider = "litellm"
# model = "openai/text-embedding-3-small"   # el prefijo antes de "/" es el proveedor (openai/, cohere/, voyage/, ollama/...); NO es una URL: el loader rechaza "://", "http" y "@"
# api_key_env = "TEPOCHCALLI_EMBED_API_KEY"  # NOMBRE de la variable de entorno; gana sobre api_key
# api_key = "sk-..."                         # clave literal alternativa (la escribe el wizard; el fichero real está en .gitignore)
# No hay campo de endpoint en este TOML: LiteLLM usa el default del proveedor (openai/ → https://api.openai.com/v1).
# Endpoint custom (Ollama/vLLM/proxy): declarar OPENAI_BASE_URL u OLLAMA_API_BASE en opencode.json → mcp.servers["tepochcalli-rag"].environment. No va en el TOML.

[chunking]
max_chunk_size = 1536         # unidad: BYTES, no chars (el splitter mide bytes) — ver F4, spec-rag-engine.md §Chunking
overlap = 192                 # 12,5% de max_chunk_size (mismo ratio que el 128/1024 original en chars)
