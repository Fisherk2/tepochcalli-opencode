{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 20000
  },
  "model": "opencode/big-pickle",
  "default_agent": "itzamna",
  "agents": {
    "itzamna": {
      "model": "opencode/big-pickle",
      "color": "#ffffff",
      "request": {
        "body": {
          "temperature": 0.5
        }
      },
      "steps": 50
    },
    "nezahualcoyotl": {
      "model": "opencode/minimax-m3.1-flash-free",
      "color": "#502f01",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 120
    },
    "pochteca": {
      "model": "opencode/mimo-v2.6-flash-free",
      "color": "#00ff00",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "steps": 100
    },
    "chilam": {
      "model": "opencode/glm-5.3-flash-free",
      "color": "#ff0000",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 150
    },
    "tlacuilo": {
      "model": "opencode/deepseek-v4.1-flash-free",
      "color": "#9e49ff",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "steps": 200
    },
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "instructions": [
    ".opencode/skills/obsidian-markdown/SKILL.md",
    ".opencode/skills/obsidian-cli/SKILL.md",
    ".opencode/skills/obsidian-vault/SKILL.md",
    ".opencode/skills/markdown-mermaid-writing/SKILL.md"
  ],
  "references": {
    "tepochcalli": {
      "repository": "Fisherk2/tepochcalli-opencode",
      "branch": "main",
      "description": "Tepochcalli repository - Learn and research with RAG"
    },
    "awesome-autoresearch": {
      "repository": "AI4Scientist/awesome-autoresearch",
      "branch": "main",
      "description": "A curated list of awesome autonomous researcher frameworks"
    },
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "dev",
      "description": "Official OpenCode repository - CLI, API, and configuration reference"
    }
  },
  "mcp": {
    "servers": {
      "tepochcalli-rag": {
        "type": "local",
        "command": [".tepochcalli/venv/bin/python", "-m", "tepochcalli_mcp"],
        "cwd": ".",
        "environment": {
          "TEPOCHCALLI_ROOT": ".",
          "INDEXER_DIR": "00-Resources",
          "TEPOCHCALLI_TOP_K": "5"
        },
        "disabled": false
      },
      "anydoc": {
        "type": "local",
        "command": ["npx","-y","mcp-server-anydoc"],
        "disabled":true
      },
      "excel": {
        "type": "local",
        "command": ["uvx", "excel-mcp-server", "stdio"],
        "disabled": true
      },
      "jupyter": {
        "type": "local",
        "command": ["uvx", "mcp-jupyter-notebook"],
        "disabled": true,
        "environment": {
          "MCP_JUPYTER_SESSION_MODE": "server",
          "MCP_JUPYTER_BASE_URL": "http://localhost:8888",
          "MCP_JUPYTER_TOKEN": "{env:MCP_JUPYTER_TOKEN}",
          "MCP_JUPYTER_NOTEBOOK_PATH": "agent_demo.ipynb"
        }
      }
    }
  },
  "plugins": [
    "opencode-rpc@latest",
    "opencode-navigator@latest",
    "opencode-skills-collection@latest",
    "opencode-skill-creator@latest",
    "opencode-search-plugin@latest",
    "opencode-parser@latest"
  ]
}
